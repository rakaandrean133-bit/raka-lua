AddHook("onsendpacket", "currency_drop_handler", function(type, str)
    if not str then return end

    if str:match("text|%s*/menu") then
        showMainMenu()
        return true
    end

    if str:match("text|%s*/fcv") then
        autoBGL = not autoBGL
        local msg = autoBGL and "`2Fast Convert DL -> BGL: ENABLED (ON)" or "`4Fast Convert DL -> BGL: DISABLED (OFF)"
        cLog(msg)
        textoverlay(msg)
        return true
    end

    if str:match("text|%s*/dall") then
        if isRunning then return true end
        isRunning = true

        RunThread(function()
            local cBlack = inv(ID_BLACK)
            local cBGL   = inv(ID_BGL)
            local cDL    = inv(ID_DL)
            local cWL    = inv(ID_WL)

            if cBlack == 0 and cBGL == 0 and cDL == 0 and cWL == 0 then
                ngomong(prefixDrop .. "`4No locks found in inventory to drop!")
                isRunning = false
                return
            end

            local gameDroppedList = {}
            local webhookDroppedList = {}

            if cBlack > 0 then
                SendPacket(2, "action|dialog_return\ndialog_name|drop\nitem_drop|" .. ID_BLACK .. "|\nitem_count|" .. cBlack)
                table.insert(gameDroppedList, "`b" .. cBlack + " Black`0")
                table.insert(webhookDroppedList, cBlack .. " Black")
                Sleep(400)
            end

            if cBGL > 0 then
                SendPacket(2, "action|dialog_return\ndialog_name|drop\nitem_drop|" .. ID_BGL .. "|\nitem_count|" .. cBGL)
                table.insert(gameDroppedList, "`e" .. cBGL .. " BGL`0")
                table.insert(webhookDroppedList, cBGL .. " BGL")
                Sleep(400)
            end

            if cDL > 0 then
                SendPacket(2, "action|dialog_return\ndialog_name|drop\nitem_drop|" .. ID_DL .. "|\nitem_count|" .. cDL)
                table.insert(gameDroppedList, "`1" .. cDL .. " DL`0")
                table.insert(webhookDroppedList, cDL .. " DL")
                Sleep(400)
            end

            if cWL > 0 then
                SendPacket(2, "action|dialog_return\ndialog_name|drop\nitem_drop|" .. ID_WL .. "|\nitem_count|" .. cWL)
                table.insert(gameDroppedList, "`9" .. cWL .. " WL`0")
                table.insert(webhookDroppedList, cWL .. " WL")
                Sleep(400)
            end

            local msg = prefixDrop .. "`4[ALL IN!] `0Dropped " .. table.concat(gameDroppedList, " ")
            ngomong(msg)
            cLog(msg)
            sendDropWebhook(DROP_WEBHOOK, "📢 **[ALL IN DROP]**", table.concat(webhookDroppedList, ", "))
            isRunning = false
        end)
        return true
    end

    local cmd, amount = str:match("text|%s*/(%a+)%s*(%d*)")
    amount = tonumber(amount)

    if not cmd or not amount or amount <= 0 then return end

    if cmd == "d" then
        if isRunning then return true end
        isRunning = true

        RunThread(function()
            local reqBGL = math.floor(amount / 100)
            local reqDL  = amount % 100

            while inv(ID_BGL) < reqBGL and inv(ID_BLACK) > 0 do
                local before = inv(ID_BGL)
                SendPacket(2, "action|dialog_return\ndialog_name|info_box\nbuttonClicked|make_bluegl")
                Sleep(350)
                if inv(ID_BGL) <= before then break end
            end

            while inv(ID_DL) < reqDL and inv(ID_BGL) > 0 do
                local before = inv(ID_DL)
                SendPacketRaw(false, {type = 10, value = ID_BGL})
                Sleep(350)
                if inv(ID_DL) <= before then break end
            end

            local totalDLHave = inv(ID_DL) + (inv(ID_BGL) * 100) + (inv(ID_BLACK) * 10000)
            if totalDLHave < amount then
                ngomong(prefixDrop .. "`4Not enough locks in inventory for drop!")
                isRunning = false
                return
            end

            local gameSummary = {}
            local webhookSummary = {}

            if reqBGL > 0 and inv(ID_BGL) >= reqBGL then
                SendPacket(2, "action|dialog_return\ndialog_name|drop\nitem_drop|" .. ID_BGL .. "|\nitem_count|" .. reqBGL)
                table.insert(gameSummary, "`e" .. reqBGL .. " BGL`0")
                table.insert(webhookSummary, reqBGL .. " BGL")
                Sleep(400)
            end

            if reqDL > 0 and inv(ID_DL) >= reqDL then
                SendPacket(2, "action|dialog_return\ndialog_name|drop\nitem_drop|" .. ID_DL .. "|\nitem_count|" .. reqDL)
                table.insert(gameSummary, "`1" .. reqDL .. " DL`0")
                table.insert(webhookSummary, reqDL .. " DL")
                Sleep(400)
            end

            local msg = prefixDrop .. "`0Dropped " .. table.concat(gameSummary, " ")
            ngomong(msg)
            cLog(msg)
            sendDropWebhook(DROP_WEBHOOK, "📦 **[DROP /d]**", table.concat(webhookSummary, ", "))

            isRunning = false
        end)
        return true

    elseif cmd == "wd" then
        if isRunning then return true end
        isRunning = true

        RunThread(function()
            local totalWLHave = inv(ID_WL) + (inv(ID_DL) * 100) + (inv(ID_BGL) * 10000) + (inv(ID_BLACK) * 1000000)
            if totalWLHave < amount then
                ngomong(prefixDrop .. "`4Not enough locks in inventory!")
                isRunning = false
                return
            end

            while inv(ID_WL) < amount and (inv(ID_DL) > 0 or inv(ID_BGL) > 0 or inv(ID_BLACK) > 0) do
                if inv(ID_DL) == 0 and inv(ID_BGL) > 0 then
                    local beforeDL = inv(ID_DL)
                    SendPacketRaw(false, {type = 10, value = ID_BGL})
                    Sleep(350)
                    if inv(ID_DL) <= beforeDL then break end
                end
                if inv(ID_DL) == 0 and inv(ID_BGL) == 0 and inv(ID_BLACK) > 0 then
                    local beforeBGL = inv(ID_BGL)
                    SendPacket(2, "action|dialog_return\ndialog_name|info_box\nbuttonClicked|make_bluegl")
                    Sleep(350)
                    if inv(ID_BGL) <= beforeBGL then break end
                end
                if inv(ID_DL) > 0 then
                    local beforeWL = inv(ID_WL)
                    SendPacketRaw(false, {type = 10, value = ID_DL})
                    Sleep(350)
                    if inv(ID_WL) <= beforeWL then break end
                end
            end

            if inv(ID_WL) >= amount then
                SendPacket(2, "action|dialog_return\ndialog_name|drop\nitem_drop|" .. ID_WL .. "|\nitem_count|" .. amount)
                local msg = prefixDrop .. "`0Dropped `9" .. amount .. " World Lock"
                ngomong(msg)
                cLog(msg)
                sendDropWebhook(DROP_WEBHOOK, "📦 **[DROP /wd]**", amount .. " WL")
            else
                ngomong(prefixDrop .. "`4Failed to break locks for WL drop!")
            end
            isRunning = false
        end)
        return true

    elseif cmd == "dd" then
        if isRunning then return true end
        isRunning = true

        RunThread(function()
            while inv(ID_DL) < amount and inv(ID_BGL) > 0 do
                local before = inv(ID_DL)
                SendPacketRaw(false, {type = 10, value = ID_BGL})
                Sleep(350)
                if inv(ID_DL) <= before then break end
            end

            if inv(ID_DL) >= amount then
                SendPacket(2, "action|dialog_return\ndialog_name|drop\nitem_drop|" .. ID_DL .. "|\nitem_count|" .. amount)
                local msg = prefixDrop .. "`0Dropped `1" .. amount .. " Diamond Lock"
                ngomong(msg)
                cLog(msg)
                sendDropWebhook(DROP_WEBHOOK, "📦 **[DROP /dd]**", amount .. " DL")
            else
                ngomong(prefixDrop .. "`4Not enough DL or BGL!")
            end
            isRunning = false
        end)
        return true

    elseif cmd == "bd" then
        if isRunning then return true end
        isRunning = true

        RunThread(function()
            while inv(ID_BGL) < amount and inv(ID_BLACK) > 0 do
                local beforeBGL = inv(ID_BGL)
                local beforeBlack = inv(ID_BLACK)
                SendPacket(2, "action|dialog_return\ndialog_name|info_box\nbuttonClicked|make_bluegl")
                Sleep(300)
                if inv(ID_BGL) <= beforeBGL and inv(ID_BLACK) >= beforeBlack then break end
            end

            if inv(ID_BGL) >= amount then
                SendPacket(2, "action|dialog_return\ndialog_name|drop\nitem_drop|" .. ID_BGL .. "|\nitem_count|" .. amount)
                local msg = prefixDrop .. "`0Dropped `e" .. amount .. " Blue Gem Lock"
                ngomong(msg)
                cLog(msg)
                sendDropWebhook(DROP_WEBHOOK, "📦 **[DROP /bd]**", amount .. " BGL")
            else
                ngomong(prefixDrop .. "`4Not enough BGL or Black Gem Lock!")
            end
            isRunning = false
        end)
        return true

    elseif cmd == "bdl" then
        if inv(ID_BLACK) >= amount then
            SendPacket(2, "action|dialog_return\ndialog_name|drop\nitem_drop|" .. ID_BLACK .. "|\nitem_count|" .. amount)
            local msg = prefixDrop .. "`0Dropped `b" .. amount .. " Black Gem Lock"
            ngomong(msg)
            cLog(msg)
            sendDropWebhook(DROP_WEBHOOK, "📦 **[DROP /bdl]**", amount .. " Black Gem Lock")
        else
            ngomong(prefixDrop .. "`4Not enough Black Gem Lock!")
        end
        return true
    end
end)

