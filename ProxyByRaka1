        if dialogLower:find("exchange for 100 diamond lock") 
        or dialogLower:find("exchange for 100 world lock") 
        or dialogLower:find("fast delivery")
        or dialogLower:find("are you sure you want to compress") then
            return true
        end

        if autoBGL and (dialogLower:find("telephone") or dialogLower:find("bglconvert") or dialogLower:find("100 diamond lock") or dialogLower:find("phone #")) then
            if inv(ID_DL) >= 100 and not isRunning then
                local tx = dialog:match("x|(%d+)")
                local ty = dialog:match("y|(%d+)")
