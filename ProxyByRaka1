local function getTelephonePos()
    for _, tile in pairs(GetTiles() or {}) do
        if tile.fg == ID_TELEPHONE or tile.bg == ID_TELEPHONE then
            return tile.x, tile.y
        end
    end
    return nil, nil
end

AddHook("onvariant", "dialog_and_convert_handler", function(var)
