-- FUNGSI MENDAPATKAN DATA PLAYER & WORLD
local function getPlayerData()
    local name = "Unknown"
    local uid = "0"
    local world = "EXIT"
    
    if GetLocal then
        local localPlayer = GetLocal()
        if localPlayer then
            name = localPlayer.name or "Unknown"
            uid = tostring(localPlayer.userid or localPlayer.netid or "0")
        end
    end
    
    if GetWorld then
        local w = GetWorld()
        if w and w.name then
            world = w.name
        end
    end
    
    name = name:gsub("`%S", "")
    return name, uid, world
end

