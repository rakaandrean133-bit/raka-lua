local function sendDropWebhook(url, title, content)
    if not url or url == "" or url:find("YOUR_") then return end
    
    local growId, uid, worldName = getPlayerData()
    local formattedMessage = string.format(
        "👤 **Player:** %s (UID: %s) | 🌍 **World:** %s\n%s %s",
        growId, uid, worldName, title, content
    )
    local payload = string.format('{"content": "%s"}', jsonEscape(formattedMessage))
    
    if HttpRequest then
        HttpRequest(url, "POST", {["Content-Type"] = "application/json"}, payload)
    elseif MakeRequest then
        MakeRequest(url, "POST", {["Content-Type"] = "application/json"}, payload)
    end
end

